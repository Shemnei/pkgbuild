prepare() {
  export PATH="/usr/bin:$PATH"
  cd "$srcdir/openwhispr-$pkgver" || return
  python "$srcdir/prepare.py" "$PWD"
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1 DO_NOT_TRACK=1
  npm ci --ignore-scripts --no-audit --no-fund
  python "$srcdir/dependencies.py" "$PWD"
}

build() {
  export PATH="/usr/bin:$PATH"
  cd "$srcdir/openwhispr-$pkgver" || return
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1 DO_NOT_TRACK=1
  # Format the reviewed patches using the upstream lockfile-pinned formatter.
  node_modules/.bin/prettier --write main.js src/updater.js src/stores/settingsStore.ts \
    src/helpers/{ensureYdotool,gpuBinaryManager,urlAudioDownloader,cloudApiRequest,ipcHandlers,linuxAutostart,linuxUrlSchemeHandler,whisperServer,llamaServer,llamaCppInstaller}.js
  # Invoke the renderer directly: npm build/prebuild downloads executable helpers.
  (cd src && ../node_modules/.bin/vite build)

  # Compile upstream C helpers directly, retaining Arch hardening/build flags.
  install -dm755 resources/bin
  cmake -S "$srcdir/whisper.cpp-$_whisperver" -B "$srcdir/whisper-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=None -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_C_FLAGS="$CFLAGS -ffile-prefix-map=$srcdir=." \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -ffile-prefix-map=$srcdir=." \
    -DGGML_NATIVE=OFF -DGGML_SSE42=OFF -DGGML_AVX=OFF -DGGML_AVX2=OFF \
    -DGGML_F16C=OFF -DGGML_FMA=OFF -DGGML_BMI2=OFF \
    -DGGML_CCACHE=OFF -DWHISPER_CURL=OFF -DWHISPER_BUILD_TESTS=ON
  cmake --build "$srcdir/whisper-build" --target whisper-server test-common-utf8
  install -m755 "$srcdir/whisper-build/bin/whisper-server" resources/bin/whisper-server
  # shellcheck disable=SC2086
  cc $CPPFLAGS $CFLAGS resources/linux-key-listener.c $LDFLAGS -o resources/bin/linux-key-listener-x64
  # shellcheck disable=SC2086,SC2046
  cc $CPPFLAGS $CFLAGS -DHAVE_UINPUT -DHAVE_GIO -DHAVE_ATSPI resources/linux-fast-paste.c \
    $LDFLAGS $(pkg-config --cflags --libs x11 xtst xext gio-2.0 atspi-2 gobject-2.0) -lm -o resources/bin/linux-fast-paste
  # shellcheck disable=SC2086,SC2046
  cc $CPPFLAGS $CFLAGS resources/linux-text-monitor.c $LDFLAGS \
    $(pkg-config --cflags --libs atspi-2 gobject-2.0) -o resources/bin/linux-text-monitor
  # shellcheck disable=SC2086,SC2046
  cc $CPPFLAGS $CFLAGS -DHAVE_PIPEWIRE resources/linux-system-audio-helper.c $LDFLAGS \
    $(pkg-config --cflags --libs gio-2.0 libpipewire-0.3) -o resources/bin/linux-system-audio-helper

  # Upstream tests use system Node; the installed addon uses the Electron 43 ABI.
  node-gyp rebuild --release --directory=node_modules/better-sqlite3 --nodedir=/usr
  python "$srcdir/deploy.py" "$PWD" "$srcdir/staged-openwhispr"
  (
    cd "$srcdir/staged-openwhispr" || return
    npm ci --omit=dev --ignore-scripts --no-audit --no-fund
    python "$srcdir/dependencies.py" "$PWD"
    node-gyp rebuild --release --directory=node_modules/better-sqlite3 \
      --target="$_electronver" --arch=x64 --nodedir="$srcdir/node_headers"
    # Keep the built addon, not its object files or source/build metadata.
    install -Dm755 node_modules/better-sqlite3/build/Release/better_sqlite3.node sqlite-addon.node
    rm -r node_modules/better-sqlite3/build
    install -Dm755 sqlite-addon.node node_modules/better-sqlite3/build/Release/better_sqlite3.node
    rm sqlite-addon.node
    python "$srcdir/deploy.py" --finalize "$PWD" "$srcdir/staged-licenses"
  )
}

check() {
  export PATH="/usr/bin:$PATH"
  cd "$srcdir/openwhispr-$pkgver" || return
  npm run format:check
  npm run typecheck
  ctest --test-dir "$srcdir/whisper-build" --output-on-failure -R '^test-common-utf8$'
  python "$srcdir/whisper-smoke.py" "$srcdir/staged-openwhispr/resources/bin/whisper-server" \
    "$srcdir/ggml-tiny.en-q5_1.bin" "$srcdir/whisper.cpp-$_whisperver/samples/jfk.wav"
  # Focused upstream contracts unaffected by the package's policy replacements.
  node --import tsx --test test/helpers/{analytics,smartSpacing,speakerMerge,transcriptFormatter,transcriptionTimeout,whisperVadConfig}.test.js
  OPENWHISPR_SOURCE="$PWD" node --test "$srcdir/policy.test.mjs" "$srcdir/source-policy.test.mjs"
  OPENWHISPR_SOURCE="$srcdir/staged-openwhispr" node --test "$srcdir/policy.test.mjs" "$srcdir/source-policy.test.mjs"
  desktop-file-validate "$srcdir/open-whispr.desktop"
  ELECTRON_RUN_AS_NODE=1 electron43 -e \
    "const D = require('$srcdir/staged-openwhispr/node_modules/better-sqlite3'); const d = new D(':memory:'); d.prepare('SELECT 1').get(); d.close()"
  readelf -d "$srcdir/staged-openwhispr/node_modules/better-sqlite3/build/Release/better_sqlite3.node" | grep -F 'libsqlite3.so.0'
}

package() {
  install -dm755 "$pkgdir/usr/lib/openwhispr"
  cp -a "$srcdir/staged-openwhispr/." "$pkgdir/usr/lib/openwhispr/"
  install -Dm755 "$srcdir/openwhispr" "$pkgdir/usr/bin/openwhispr"
  install -Dm644 "$srcdir/open-whispr.desktop" "$pkgdir/usr/share/applications/open-whispr.desktop"
  install -Dm644 "$srcdir/openwhispr-$pkgver/src/assets/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/open-whispr.png"
  install -Dm644 "$srcdir/openwhispr-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/whisper.cpp-$_whisperver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/whisper.cpp-LICENSE"
  cp -a "$srcdir/staged-licenses" "$pkgdir/usr/share/licenses/$pkgname/node_modules"
  install -Dm644 "$srcdir/onnxruntime-1.27.0-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/onnxruntime-LICENSE"
  install -Dm644 "$srcdir/onnxruntime-1.27.0-ThirdPartyNotices.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/onnxruntime-ThirdPartyNotices.txt"
  install -Dm644 "$srcdir/openwhispr-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/upstream.md"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
