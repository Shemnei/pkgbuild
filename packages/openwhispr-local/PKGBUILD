# Maintainer: Local package maintainers
# shellcheck disable=SC2034,SC2154

pkgname=openwhispr-local
pkgver=1.11.0
pkgrel=1
pkgdesc='Desktop dictation and meeting transcription without self-updates or usage reporting'
arch=('x86_64')
url='https://github.com/OpenWhispr/openwhispr'
license=('MIT' 'Apache-2.0' 'BSD-2-Clause' 'BSD-3-Clause' 'ISC' '0BSD' 'BlueOak-1.0.0' 'AGPL-3.0-or-later' 'OFL-1.1' 'Python-2.0' 'MPL-2.0')
depends=(
  'electron43>=43.8.3' 'ffmpeg' 'glibc' 'glib2' 'libx11' 'libxtst'
  'libxext' 'at-spi2-core' 'libpipewire' 'libsecret' 'xdg-utils' 'which' 'procps-ng' 'libgomp' 'sqlite'
  'bash' 'libgcc' 'libstdc++' 'hicolor-icon-theme'
)
makedepends=('nodejs>=24' 'npm' 'node-gyp' 'python' 'pkgconf' 'cmake' 'ninja')
checkdepends=('desktop-file-utils')
optdepends=(
  'xdotool: X11 keystroke injection and active-window detection'
  'xclip: X11 clipboard support'
  'xsel: alternative X11 clipboard support'
  'wl-clipboard: Wayland clipboard support'
  'wtype: wlroots Wayland keystroke injection'
  'ydotool: alternative Wayland keystroke injection, requires manual daemon setup'
  'kdotool: KDE Wayland active-window detection'
  'playerctl: pause and resume media through MPRIS'
  'yt-dlp: import audio from supported video URLs'
  'xdg-desktop-portal: desktop permission and screen/audio portals'
  'gnome-keyring: one possible Secret Service provider for credential storage'
)
provides=("openwhispr=$pkgver")
conflicts=('openwhispr' 'openwhispr-bin' 'openwhispr-git')
# One output package: automatic debug packages would not have a -local suffix.
options=('!debug')
_electronver=43.8.9
_whisperver=0.0.11
source=(
  "openwhispr-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "electron-$_electronver-headers.tar.gz::https://artifacts.electronjs.org/headers/dist/v$_electronver/node-v$_electronver-headers.tar.gz"
  'onnxruntime-1.27.0-LICENSE::https://raw.githubusercontent.com/microsoft/onnxruntime/v1.27.0/LICENSE'
  'onnxruntime-1.27.0-ThirdPartyNotices.txt::https://raw.githubusercontent.com/microsoft/onnxruntime/v1.27.0/ThirdPartyNotices.txt'
  "whisper.cpp-$_whisperver.tar.gz::https://codeload.github.com/OpenWhispr/whisper.cpp/tar.gz/refs/tags/$_whisperver"
  'ggml-tiny.en-q5_1.bin::https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-tiny.en-q5_1.bin'
  'prepare.py'
  'dependencies.py'
  'deploy.py'
  'updater.cjs'
  'gpu-binary.cjs'
  'policy.test.mjs'
  'source-policy.test.mjs'
  'openwhispr'
  'open-whispr.desktop'
  'README.md'
  'whisper-smoke.py'
)
